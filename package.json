{
  "name": "lookgo-frontend-vue3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ],
    "*.{js,ts,vue,css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@stomp/stompjs": "7.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "jspdf": "4.2.1",
    "jwt-decode": "4.0.0",
    "keycloak-js": "26.2.4",
    "lodash-es": "4.18.1",
    "pinia": "4.0.3",
    "taiwan-id-validator": "2.1.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "4.6.4",
    "vuetify": "3.13.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/lodash-es": "4.17.12",
    "@playwright/test": "1.64.0",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-vue": "10.11.0",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.82.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
